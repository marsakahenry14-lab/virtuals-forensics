# Environment configuration for deterministic reproduction
# Copy this file to .env and set your values before running indexer.py

# Base Mainnet RPC endpoint
# Recommended for reproduction: an Alchemy Base Mainnet endpoint.
# The public https://mainnet.base.org endpoint is not suitable for deterministic
# reproduction because eth_getLogs may be truncated by result-count limits.
BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_KEY

# Pinned block range for the published dataset.
# CLI flags take precedence over these values.
START_BLOCK=44427013
END_BLOCK=47718785

# Optional canary: fail loudly if the final JobCreated row count differs.
# EXPECTED_JOBCREATED=62953
